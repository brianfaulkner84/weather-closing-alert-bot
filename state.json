      - name: Commit updated state.json
        run: |
          if ! git diff --quiet -- state.json; then
            git config user.name "github-actions[bot]"
            git config user.email "github-actions[bot]@users.noreply.github.com"
            git add state.json
            git commit -m "Update alert state [skip ci]"
            # A concurrent or re-run job may have pushed state.json first;
            # rebase onto the current tip and retry a few times rather than
            # failing the whole run over a stale push.
            for attempt in 1 2 3 4 5; do
              if git pull --rebase origin "${GITHUB_REF_NAME}" && git push; then
                break
              fi
              if [ "$attempt" -eq 5 ]; then
                echo "Failed to push state.json after 5 attempts." >&2
                exit 1
              fi
              sleep $((attempt * 2))
            done
          else
            echo "state.json unchanged; nothing to commit."
          fi
